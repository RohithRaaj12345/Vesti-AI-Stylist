# Required — get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- Email OTP via SMTP (set these to send real verification emails) ---
# When SMTP_HOST is set, codes are emailed for real; otherwise dev mode logs them.
# Gmail example: host smtp.gmail.com, port 587, username = your gmail,
#   password = a Google "App Password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- The following are set automatically by docker-compose; listed for reference ---
# MYSQL_HOST=db
# MYSQL_PORT=3306
# MYSQL_USER=vesti
# MYSQL_PASSWORD=vestipass
# MYSQL_DB=vesti
# REDIS_URL=redis://redis:6379/0
# RATE_LIMIT_WINDOW_MIN=30        # 1 upload per user per this many minutes
# SESSION_TTL=604800              # login session lifetime in seconds (7 days)
# PHONE_REGION=IN                 # mobile-number region for validation
# OTP_DEV_MODE=true               # true = codes written to data/app.log (no real email/SMS)
